    <!-- Calls and recordings setup -->
    <string name="setup_title">Calls and recordings</string>
    <string name="setup_intro">Do these once on this phone. The app then shows who is calling, asks for notes after CRM calls, and finds the dialer\'s recordings.</string>
    <string name="setup_fix">Allow</string>
    <string name="setup_change">Change</string>
    <string name="setup_done">Done</string>
    <string name="setup_phone">Phone and call log</string>
    <string name="setup_phone_why">To know when a CRM lead calls or is called. Calls with other numbers are ignored and never leave the phone.</string>
    <string name="setup_overlay">Show over other apps</string>
    <string name="setup_overlay_why">For the caller bubble during a call and the notes sheet right after it. Turn on "Allow display over other apps" for this app.</string>
    <string name="setup_notify">Notifications</string>
    <string name="setup_notify_why">For new leads, sync requests from your manager, and notes reminders.</string>
    <string name="setup_mic">Microphone</string>
    <string name="setup_mic_why">Only for voice notes you record yourself (for example why a lead was lost).</string>
    <string name="setup_battery">Keep the app running</string>
    <string name="setup_battery_samsung">Allow "unrestricted" battery use. Then Settings → Battery → Background usage limits: make sure this app is not in "Sleeping apps" or "Deep sleeping apps".</string>
    <string name="setup_battery_xiaomi">Allow "no restrictions" battery use. Then Settings → Apps → this app → Autostart: on, and Battery saver: No restrictions.</string>
    <string name="setup_battery_coloros">Allow unrestricted battery use. Then Settings → Apps → this app → Battery → Allow background activity and Allow auto launch.</string>
    <string name="setup_battery_vivo">Allow unrestricted battery use. Then i Manager → App manager → Autostart: on for this app, and Battery → High background power use: on.</string>
    <string name="setup_battery_other">Allow unrestricted battery use, and turn off any "auto-start" or "sleeping apps" limit for this app in the phone\'s settings.</string>
    <string name="setup_folder">Recordings folder</string>
    <string name="setup_folder_samsung">Turn on call recording in the Phone app (⋮ → Settings → Record calls → Auto record). Then choose Internal storage → Recordings → Call.</string>
    <string name="setup_folder_xiaomi">Turn on call recording in the Phone app. Then choose Internal storage → MIUI → sound_recorder → call_rec.</string>
    <string name="setup_folder_coloros">Turn on call recording in the Phone app. Then choose Internal storage → Music → Recordings → Call Recordings (or Recordings → Call).</string>
    <string name="setup_folder_vivo">Turn on call recording in the Phone app. Then choose Internal storage → Recordings → Record → Call.</string>
    <string name="setup_folder_other">Turn on call recording in the Phone app, then choose the folder where it saves recordings. (Phones with the Google Phone app keep recordings inside the dialer; they can\'t be read.)</string>
    <string name="setup_folder_chosen">Chosen: %1$s</string>
