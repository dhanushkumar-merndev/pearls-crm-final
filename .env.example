# ─────────────────────────────────────────────────────────────────────────────
# Pearl CRM — all keys in one place.
#
# 1. Copy this file to ".env" (same folder). ".env" is never committed to git.
# 2. Fill in a section when its phase starts. Empty keys are fine until then.
# 3. Run:  pnpm env:sync
#    It copies each key ONLY where it is needed:
#      web keys      → web/.env.local          (the browser app; never gets secrets)
#      server keys   → supabase/functions/.env (Edge Functions)
#      deploy keys   → stay here, used by deploy commands only
#
# Never paste secret values into chat, screenshots or WhatsApp.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ 1. WEB APP ═══ (→ web/.env.local; later also Vercel → Settings → Environment Variables)
# Local values below work as-is with `pnpm db:start`.
# Online: Supabase dashboard → Project Settings → API → "Project URL" and "anon / publishable" key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Public key (safe in the browser). NEVER put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Any long random text. The daily keep-alive job must send it.
CRON_SECRET=change-me-to-a-long-random-string
# Phase 2 — Cloudflare Turnstile (bot check on the QR self-registration page).
# dash.cloudflare.com → Turnstile → Add site → "Site key".
# Default = Cloudflare's public TEST key (always passes). Replace with your real site key before go-live.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA


# ═══ 2. PRIVATE FILES: TIGRIS ═══ (→ supabase/functions/.env) — Phase 0, needed for uploads
# Bucket "pearl-staging" (Singapore, private) was created with the Tigris CLI; its key only works on that bucket.
# The key is written here by a command, not typed by hand (dev-docs/SETUP.md 2.2).
STORAGE_ENDPOINT=https://t3.storage.dev
STORAGE_REGION=auto
STORAGE_BUCKET=pearl-staging
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Leave empty for Tigris. "true" only for a local MinIO server.
STORAGE_PATH_STYLE=
# Web app addresses allowed to call the Edge Functions from a browser, comma-separated.
# The https:// one is the live site (login emails link to it): http://localhost:3000,https://pearl-sales.vercel.app
WEB_ORIGIN=http://localhost:3000


# ═══ 3. BOT CHECK (server side) ═══ (→ supabase/functions/.env) — Phase 2
# Same Turnstile site → "Secret key".
# Default = Cloudflare's public TEST secret (always passes). Replace with your real secret before go-live.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA


# ═══ 4. EMAIL: BREVO ═══ — online testing / go-live (local emails show at http://127.0.0.1:54324)
# brevo.com → SMTP & API.
# SMTP_* go to the online Supabase project (Authentication → Emails → SMTP) when we deploy.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=Clinic CRM
# Phase 14 — admin daily summary email. brevo.com → SMTP & API → API keys. (→ supabase/functions/.env)
BREVO_API_KEY=


# ═══ 5. META LEAD ADS (Facebook + Instagram leads) ═══ (→ supabase/functions/.env) — Phase 9
# developers.facebook.com → your app. Step-by-step guide comes in dev-docs/SETUP_META.md.
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# Any long random text; you paste the same text into Meta's webhook settings.
META_WEBHOOK_VERIFY_TOKEN=


# ═══ 6. WHATSAPP CLOUD API ═══ (→ supabase/functions/.env) — Phase 10
# business.facebook.com → WhatsApp Manager / your app → WhatsApp → API Setup.
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
# Permanent System User token (not the 24-hour test token).
WHATSAPP_ACCESS_TOKEN=
# App secret of the Meta app that owns the WhatsApp number (checks webhook signatures).
WHATSAPP_APP_SECRET=
# Any long random text; paste the same into the WhatsApp webhook settings.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Lets the database's 5-minute timer start the sending function. Leave empty:
# pnpm supabase:configure makes one and stores it here and on the server.
EDGE_CRON_SECRET=


# ═══ 7. PUSH NOTIFICATIONS: FIREBASE ═══ (→ supabase/functions/.env) — Phase 11 (Android)
# console.firebase.google.com → Project settings → Service accounts → Generate new private key.
# Paste the downloaded JSON file's contents on ONE line.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
# The Android file google-services.json goes in android/app/ (not here).


# ═══ 8. MAPS / ROUTES: OPENROUTESERVICE ═══ (→ supabase/functions/.env) — Phase 13 (BDM)
# openrouteservice.org → Sign up → Dashboard → Request a token (free).
ORS_API_KEY=


# ═══ 9. DEPLOY (online staging / production) ═══ — stays in this file only
# supabase.com → Account → Access Tokens → Generate (lets commands deploy to your project).
SUPABASE_ACCESS_TOKEN=
# From the project URL: https://<project-ref>.supabase.co
SUPABASE_PROJECT_REF=
# The database password you saved when creating the project.
SUPABASE_DB_PASSWORD=
# Local database for test scripts (pnpm db:concurrency). Works as-is locally.
# Online: Supabase dashboard → Connect → "Session pooler" connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Password of the online test logins (usernames admin, reception, manager, sales, bdm).
# Generated automatically; open this file to read it when you want to log in.
STAGING_TEST_PASSWORD=
